    {
      "name": "02 - Riesgos del registro",
      "description": "Lo que el registro tiene que cumplir según la decisión del equipo (solo un Administrador con sesión crea usuarios) y las buenas prácticas.\n\n**Estos tests fallan hoy a propósito.** Pasan cuando el backend:\n1. Protege POST /v1/auth/registro con autenticar + autorizar(\"Administrador\").\n2. No devuelve el hash de la contraseña.\n3. Responde 409 ante usuario o email repetido (hoy responde 500).",
      "item": [
        {
          "name": "POST Registrar sin sesión (debería ser 401)",
          "description": "Cualquiera que tenga la URL de la API puede crearse una cuenta.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Rechaza el registro sin token (401)', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombreUsuario\": \"test_anon_{{sufijo}}\",\n  \"email\": \"test_anon_{{sufijo}}@test.com\",\n  \"contrasena\": \"{{contrasena_prueba}}\",\n  \"repetirContrasena\": \"{{contrasena_prueba}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/auth/registro"
          }
        },
        {
          "name": "POST Registrar Administrador sin sesión (debería ser 401)",
          "description": "Hoy cualquiera puede darse a sí mismo el perfil Administrador mandando rol en el body.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Rechaza el registro sin token (401)', () => pm.response.to.have.status(401));",
                  "if (pm.response.code === 201) {",
                  "    pm.test('No entrega una cuenta de Administrador sin sesión', () => {",
                  "        pm.expect(pm.response.json().usuario.rol).to.not.eql('Administrador');",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombreUsuario\": \"test_anonadm_{{sufijo}}\",\n  \"email\": \"test_anonadm_{{sufijo}}@test.com\",\n  \"contrasena\": \"{{contrasena_prueba}}\",\n  \"repetirContrasena\": \"{{contrasena_prueba}}\",\n  \"rol\": \"Administrador\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/auth/registro"
          }
        },
        {
          "name": "POST Registrar - no expone el hash de la contraseña",
          "description": "La respuesta devuelve el documento completo del usuario, con el hash bcrypt.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('La respuesta no incluye contrasena', () => {",
                  "    const texto = pm.response.text();",
                  "    pm.expect(texto).to.not.include('\"contrasena\"');",
                  "    pm.expect(texto).to.not.match(/\\$2[aby]\\$/);",
                  "});"
                ]
              }
            }
          ],
